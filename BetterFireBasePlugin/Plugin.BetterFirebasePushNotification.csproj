<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net10.0-android;net10.0-ios</TargetFrameworks>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>

        <!-- Assembly and namespace info: flattened fork of Tobias Buchholz's
             Plugin.Firebase Core + CloudMessaging (github.com/TobiasBuchholz/Plugin.Firebase)
             with TRNSPRNT additions for silent pushes and notification user actions. -->
        <AssemblyName>Plugin.BetterFirebasePushNotification</AssemblyName>
        <RootNamespace>Plugin.BetterFirebasePushNotification</RootNamespace>

        <PackageId>Plugin.BetterFirebasePushNotification</PackageId>
        <PackageVersion>4.0.3</PackageVersion>

        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <Title>TRNSPRNT Plugin.Firebase (Core + CloudMessaging)</Title>
        <Summary>Flattened fork of Plugin.Firebase (Core + CloudMessaging) with silent push and user action support.</Summary>
        <Description>Cloud Messaging plugin for MAUI: fork of Plugin.Firebase (Core + CloudMessaging) flattened into one assembly with silent notification handling (data key 'silent') and notification user action buttons. Entry point: BetterFirebasePushNotification.Current (fork of CrossFirebaseCloudMessaging).</Description>
        <Authors>Tobias Buchholz, TRNSPRNT</Authors>
        <Owners>TRNSPRNT</Owners>
        <PackageProjectUrl>https://github.com/TobiasBuchholz/Plugin.Firebase</PackageProjectUrl>
        <PackageTags>maui, ios, android, firebase, cloudmessaging, firebase, push</PackageTags>
        <Product>$(AssemblyName) ($(TargetFramework))</Product>
        <LangVersion>default</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <!-- license must be packed into the nupkg for PackageLicenseFile to work -->
        <None Include="LICENSE" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <!-- This None is here so the conditionally included files show up in the Solution Explorer -->
        <None Include="**\*.cs" Exclude="obj\**\*.*;bin\**\*.*;bin;obj" />
        <Compile Include="Core\Shared\**\*.cs" />
        <Compile Include="CloudMessaging\Shared\**\*.cs" />
    </ItemGroup>

    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
        <Compile Include="Core\Platforms\Android\**\*.cs" />
        <Compile Include="CloudMessaging\Platforms\Android\**\*.cs" />
    </ItemGroup>

    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
        <Compile Include="Core\Platforms\iOS\**\*.cs" />
        <Compile Include="CloudMessaging\Platforms\iOS\**\*.cs" />
    </ItemGroup>

    <!-- nuget packages -->
    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
      <PackageReference Include="AdamE.Firebase.iOS.Core" Version="[12.7.0,)" />
      <PackageReference Include="AdamE.Firebase.iOS.CloudMessaging" Version="[12.7.0,)" />
    </ItemGroup>

    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
        <PackageReference Include="GoogleGson" Version="2.11.0.3" />
        <PackageReference Include="Xamarin.Firebase.Common" Version="121.0.0.6" />
        <PackageReference Include="Xamarin.Firebase.Messaging" Version="124.0.0.2" />
    </ItemGroup>

</Project>
